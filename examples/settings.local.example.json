{
  "permissions": {
    "allow": [
      "Read(/src/**)",
      "Read(/tests/**)",
      "Read(/docs/**)",
      "Read(/TASK.md)",
      "Edit(/src/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --check)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(python3 -m pytest)"
    ],
    "deny": [
      "Read(/**/.env*)",
      "Edit(/**/.env*)",
      "Read(/secrets/**)",
      "Edit(/secrets/**)"
    ]
  }
}
